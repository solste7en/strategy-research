# Alpaca Market Data API — required for AlpacaBarsProvider
# Sign up free at https://alpaca.markets (paper-trading account is sufficient)
# Keys are under: Account → API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Schwab API — only needed if using SchwabBarsProvider for recent live data
# (shared with schwab_app; copy token.json + these vars from that repo)
# SCHWAB_APP_KEY=your_schwab_app_key_here
# SCHWAB_APP_SECRET=your_schwab_app_secret_here
