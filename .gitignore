# ── Local data & results (never commit) ────────────────────────────
*.parquet
strategy/data_cache/*
strategy/schwab_cache/*
strategy/results/*.csv
strategy/results/*.md
!strategy/data_cache/.gitkeep
!strategy/schwab_cache/.gitkeep
!strategy/results/.gitkeep

# ── Credentials & secrets ───────────────────────────────────────────
.env
token.json
*.pem
*.key

# ── Logs ────────────────────────────────────────────────────────────
*.log
logs/

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# ── Test coverage ────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/

# ── macOS ────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE & AI assistants ──────────────────────────────────────────────
.vscode/
.idea/
.cursor/
.claude/
*.swp
*.swo
